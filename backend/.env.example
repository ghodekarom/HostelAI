# ==============================================================================
# HFCMS BACKEND ENVIRONMENT TEMPLATE (backend/.env.example)
# Copy this file to backend/.env and customize with your local/environment values.
# NEVER commit the real .env file with secrets into version control.
# ==============================================================================

# Application Profile & Server Port
SPRING_PROFILES_ACTIVE=local
PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# Database Configuration (PostgreSQL 15+)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hfcms
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# JWT Security Configuration
SECURITY_JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SECURITY_JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
SECURITY_JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
SECURITY_BCRYPT_STRENGTH=12

# Storage Configuration (supabase | local)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIRECTORY=./uploads/evidence
STORAGE_SUPABASE_URL=https://your-project.supabase.co
STORAGE_SUPABASE_KEY=your-supabase-service-role-key
STORAGE_SUPABASE_BUCKET=hfcms-evidence

# Email Service (mailpit | resend)
EMAIL_PROVIDER=mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@hfcms.internal
RESEND_API_KEY=re_your_resend_api_key

# AI Service Configuration (anthropic)
AI_PROVIDER=anthropic
AI_ANTHROPIC_API_KEY=sk-ant-your-claude-api-key
AI_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=2
AI_MOCK_ENABLED=true

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,https://hfcms.vercel.app

# Logging & Management
LOG_LEVEL_APP=DEBUG
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
