# ==============================================================================
# HFCMS FRONTEND ENVIRONMENT TEMPLATE (frontend/.env.example)
# Copy this file to frontend/.env and customize with your local/environment values.
# NEVER expose backend secrets, database URLs, or private keys to the frontend.
# ==============================================================================

# Backend REST API Base URL (Must target /api/v1)
HFCMS_API_BASE_URL=http://localhost:8080/api/v1

# Real-Time WebSocket Base URL (STOMP connection over WS)
HFCMS_WS_BASE_URL=ws://localhost:8080/ws/notifications

# Runtime Environment identifier (development | staging | production)
HFCMS_ENVIRONMENT=development

# Network Timeouts (in milliseconds)
HFCMS_CONNECT_TIMEOUT=10000
HFCMS_RECEIVE_TIMEOUT=10000
